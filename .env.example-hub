# Kapsule — Hub (VPS) — variables d'environnement
#
# Sur le VPS qui héberge le Hub (kapsule.hureau.com) :
#   cp .env.example-hub .env
#
# Puis ajuster au minimum JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD_HUB.
# `${VAR:-defaut}` dans les fichiers compose = « valeur du .env, sinon ce défaut ».
# ⚠️ En prod, changer impérativement JWT_SECRET et ADMIN_PASSWORD_HUB.

# ─────────────────────────────────────────────────────────────────────────────
# Backend Hub
# ─────────────────────────────────────────────────────────────────────────────

# Secret de signature des JWT du Hub. Longue chaîne aléatoire en prod.
JWT_SECRET=change-me

# Racine de stockage DANS le conteneur (mappée sur un volume Docker).
DATA_DIR=/app/data

# Port interne du backend Express (derrière Nginx).
PORT=3001

# Compte admin créé automatiquement au démarrage si absent (évite le script create-admin).
# Laisser vide pour désactiver le seed automatique.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HUB=change-me

# Inscription publique en libre-service. Laisser `false` : admins via `create-admin`,
# clients via l'interface super-admin (lien d'enregistrement envoyé par email si SMTP
# configuré, sinon affiché/copiable). Note : l'URL d'enregistrement est dérivée
# automatiquement de l'hôte de la requête — aucune variable d'URL publique à configurer.
ALLOW_REGISTER=false

# ─────────────────────────────────────────────────────────────────────────────
# Edge proxy + auto-provisioning preview (docker-compose.hub.yml)
# ─────────────────────────────────────────────────────────────────────────────

# Domaine principal du Hub. Utilisé par l'edge nginx (routing wildcard) et par
# le provisioner pour construire les URLs de preview (essai-<slug>.<domaine>).
EDGE_DOMAIN=kapsule.hureau.com

# ─────────────────────────────────────────────────────────────────────────────
# SMTP — envoi des emails (lien de définition de mot de passe, notifications)
# ─────────────────────────────────────────────────────────────────────────────
# Laisser SMTP_HOST vide pour désactiver l'envoi : les liens restent affichés et
# copiables dans l'admin (transmission manuelle). Renseigner pour activer l'envoi.
SMTP_HOST=
SMTP_PORT=587
# true = TLS implicite (port 465) ; false = STARTTLS (port 587, défaut courant).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Adresse expéditeur affichée. Format « Nom <adresse> » ou simple adresse.
SMTP_FROM=Kapsule <noreply@kapsule.hureau.com>

# ─────────────────────────────────────────────────────────────────────────────
# Auto-provisioning des bornes d'essai (preview)
# ─────────────────────────────────────────────────────────────────────────────

# Images Docker pour l'auto-provisioning (frontend nginx SPA + backend borne Express).
# À construire/taguer sur le VPS avant le premier déploiement :
#   docker compose -f docker-compose.preview.yml build
#   docker tag kapsule-borne-preview-frontend kapsule-borne-preview-frontend
#   docker tag kapsule-borne-preview-backend  kapsule-borne-preview-backend
PREVIEW_IMAGE=kapsule-borne-preview-frontend
PREVIEW_BACKEND_IMAGE=kapsule-borne-preview-backend

# URL interne du backend Hub, joignable par les containers preview via hub_net.
# Ne pas changer sauf si le service backend est renommé.
HUB_URL_INTERNAL=http://hub-backend:3001

# TECH_PASSWORD injecté aux backends preview auto-provisionnés. Si absent, le provisioner
# génère un secret jetable (la preview n'a pas vocation à un login technicien). Le backend
# borne REFUSE de démarrer si TECH_PASSWORD vaut une valeur d'exemple ("tech123" ou
# "change-me") → 502 sur la preview.
TECH_PASSWORD_PREVIEW=

# PREVIEW_BIND_MOUNT=true force un bind mount (au lieu d'un volume nommé Docker) pour les
# données des containers preview — utile UNIQUEMENT en dev direct hors Docker (provisioner.js
# lancé sur l'hôte, sans docker.sock côté conteneur Hub). Laisser vide en déploiement normal
# (docker-compose.hub.yml, backend dans un conteneur) : le comportement par défaut convient.
# PREVIEW_BIND_MOUNT=

# ─────────────────────────────────────────────────────────────────────────────
# Conteneur d'essai (docker-compose.preview.yml) — debug / lancement manuel
# ─────────────────────────────────────────────────────────────────────────────
# En production, les containers preview sont créés automatiquement par le backend
# Hub à la création d'événement (via docker.sock). Ce bloc sert uniquement au
# lancement manuel pour le debug :
#   BOX_TOKEN_PREVIEW=xxx PREVIEW_SLUG=monnom \
#   docker compose -f docker-compose.preview.yml -p preview-monnom up -d
#
# HUB_URL par défaut dans le compose : http://hub-backend:3001 (réseau interne).
# MAX_DATA_BYTES (1 Go) et PREVIEW_MODE=true sont fixés dans le compose.

BOX_TOKEN_PREVIEW=
# Slug DNS-safe identifiant le container (ex: "mariage-dupont"). Doit correspondre
# au slug calculé par slugFor(eventId) dans provisioner.js pour que l'edge route correctement.
PREVIEW_SLUG=debug
